STEP 6: CREATE JAR FILE
--------------------------------------------------------

[TERMINAL]

jar -cvf mapreduce.jar word/*.class

-- Check JAR contents:

jar tf mapreduce.jar

-- Check for:
word/Classword.class


--------------------------------------------------------
STEP 7: UPLOAD INPUT FILE TO HDFS
--------------------------------------------------------

[TERMINAL]

hdfs dfs -mkdir -p /user/cloudera

hdfs dfs -put -f count.txt /user/cloudera/

-- Check uploaded file:

hdfs dfs -ls /user/cloudera/

hdfs dfs -cat /user/cloudera/count.txt


--------------------------------------------------------
STEP 8: RUN MAPREDUCE PROGRAM
--------------------------------------------------------

[TERMINAL]

cd ~/mapreduce

-- Display local input file:

cat count.txt

-- Display HDFS input file:

hdfs dfs -cat /user/cloudera/count.txt

-- Delete previous output directory:

hdfs dfs -rm -r -f /user/cloudera/result

-- Execute MapReduce program:

hadoop jar mapreduce.jar word.Classword /user/cloudera/count.txt /user/cloudera/result


