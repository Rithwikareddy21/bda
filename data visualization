EXPERIMENT NO. 7
PROGRAMS ON DATA VISUALIZATION TECHNIQUES
============================================================

AIM:
To explore various data visualization techniques with Python libraries.


[1] IMPORTING LIBRARIES

import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns
import plotly.express as px


[2] LOAD DATASET

data = sns.load_dataset('iris')
data.head()


[3] HISTOGRAM

plt.figure(figsize=(8, 5))
sns.histplot(data['sepal_length'], kde=True, color='purple')
plt.title('Histogram of Sepal Length')
plt.xlabel('Sepal Length')
plt.ylabel('Frequency')
plt.show()


[4] BOX PLOT

plt.figure(figsize=(8, 5))
sns.boxplot(x='species', y='sepal_length', data=data, palette='Set2')
plt.title('Box Plot of Sepal Length by Species')
plt.show()


[5] SCATTER PLOT WITH REGRESSION LINE

plt.figure(figsize=(8, 5))
sns.regplot(x='sepal_length', y='petal_length', data=data, color='blue')
plt.title('Scatter Plot with Regression Line (Sepal vs Petal Length)')
plt.show()


[6] HEATMAP

plt.figure(figsize=(8, 6))
numeric_df = data.drop(columns=['species'])
sns.heatmap(numeric_df.corr(), annot=True, cmap='coolwarm', fmt='.2f')
plt.title('Correlation Heatmap')
plt.show()


[7] 3D INTERACTIVE PLOT

fig = px.scatter_3d(data, x='sepal_length', y='sepal_width', z='petal_length',
                    color='species', title='3D Interactive Plot of Iris Dataset')
fig.show()


